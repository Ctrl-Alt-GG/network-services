# {{ansible_managed}}
rtsp: false
webrtc: false
srt: false
moq: false
rtmp: true
hls: true
api: true

rtmpEncryption: optional
rtmpServerKey: server.key
rtmpServerCert: server.crt

authMethod: internal
authInternalUsers:
  - user: {{ mediamtx_admin_user }}
    pass: {{ mediamtx_admin_password }}
    permissions:
      - action: api

  - user: {{ mediamtx_streamer_user }}
    pass: {{ mediamtx_streamer_password }}
    permissions:
      - action: publish
        path: {{ mediamtx_liveout_path }}

  - user: {{ mediamtx_ingest_user }}
    pass: {{ mediamtx_ingest_password }}
    permissions:
      - action: publish
        path: {{ mediamtx_ingest_path }}

  - user: any
    permissions:
      - action: publish
        path: '{{ mediamtx_any_publish_regex }}'
      - action: read
        path:
      - action: playback
        path:

pathDefaults:
  source: publisher
  overridePublisher: no

paths:
  {{ mediamtx_liveout_path }}:
    overridePublisher: yes
    runOnReady: >
      ffmpeg -i rtmp://localhost:1935/{{ mediamtx_liveout_path }} -c copy -map 0 -f tee
      "[f=flv:onfail=ignore]rtmp://a.rtmp.youtube.com/live2/{{ mediamtx_youtube_stream_key }}|[f=flv:onfail=ignore]rtmp://live.twitch.tv/app/{{ mediamtx_twitch_stream_key }}"
    runOnReadyRestart: yes

  {{ mediamtx_ingest_path }}:
    overridePublisher: yes

  all_others:

